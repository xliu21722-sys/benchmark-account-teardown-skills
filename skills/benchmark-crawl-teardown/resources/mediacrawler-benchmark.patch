+++ b/config/dy_config.py
@@ -44,3 +44,13 @@ DY_CREATOR_ID_LIST = [
     "MS4wLjABAAAATJPY7LAlaa5X-c8uNdWkvz0jUGgpw4eeXIwu_8BhvqE"
     # ........................
 ]
+
+# ---- 对标调研模式（benchmark-crawl-teardown 用，默认关闭，不影响原有用法）----
+# 开启方式：运行前设环境变量 DY_BENCHMARK_MODE=1，只作用于 --type creator。
+# 开启后：取消每号 10 条上限、翻到 DY_CREATOR_SINCE 之前就停、直接用作品列表数据（不再逐条请求详情）、
+#         额外保存 duration / is_top / source_creator（你提供的主页 sec_user_id）/ source_follower_count。
+# 额外字段只适合 json / jsonl / csv 导出。
+import os as _os
+DY_BENCHMARK_MODE = _os.getenv("DY_BENCHMARK_MODE", "0") == "1"
+DY_CREATOR_SINCE = _os.getenv("DY_CREATOR_SINCE", "")  # "YYYY-MM-DD"，早于此日期的非置顶作品不再采集
+DY_CREATOR_MAX_POSTS = int(_os.getenv("DY_CREATOR_MAX_POSTS", "300"))  # 每号安全上限
