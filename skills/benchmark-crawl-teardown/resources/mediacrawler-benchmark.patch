     async def get_all_user_aweme_posts(self, sec_user_id: str, callback: Optional[Callable] = None):
+        benchmark = getattr(config, "DY_BENCHMARK_MODE", False)
+        limit = config.DY_CREATOR_MAX_POSTS if benchmark else min(config.CRAWLER_MAX_NOTES_COUNT, 10)
+        since_ts = 0
+        if benchmark and getattr(config, "DY_CREATOR_SINCE", ""):
+            import datetime
+            since_ts = int(datetime.datetime.strptime(config.DY_CREATOR_SINCE, "%Y-%m-%d").timestamp())
         posts_has_more = 1
         max_cursor = ""
         result = []
-        while posts_has_more == 1:
-            aweme_post_res = await self.get_user_aweme_posts(sec_user_id, max_cursor)
+        reached_since = False
+        while posts_has_more == 1 and len(result) < limit:
+            aweme_post_res = await self.get_user_aweme_posts(sec_user_id, max_cursor, count=18 if benchmark else 10)
             posts_has_more = aweme_post_res.get("has_more", 0)
             max_cursor = aweme_post_res.get("max_cursor")
             aweme_list = aweme_post_res.get("aweme_list") if aweme_post_res.get("aweme_list") else []
             utils.logger.info(f"[DouYinClient.get_all_user_aweme_posts] get sec_user_id:{sec_user_id} video len : {len(aweme_list)}")
+            reached_since = False
+            if since_ts:
+                kept = []
+                for item in aweme_list:
+                    if (item.get("create_time") or 0) >= since_ts:
+                        kept.append(item)
+                    elif not item.get("is_top"):
+                        reached_since = True  # 非置顶作品已早于起始日，后面只会更早
+                aweme_list = kept
+            aweme_list = aweme_list[:max(0, limit - len(result))]
             if callback:
                 await callback(aweme_list)
             result.extend(aweme_list)
+            if reached_since:
+                utils.logger.info(f"[DouYinClient.get_all_user_aweme_posts] reached DY_CREATOR_SINCE={config.DY_CREATOR_SINCE}, stop paging")
+                break
+            await asyncio.sleep(config.CRAWLER_MAX_SLEEP_SEC)
+        if benchmark:
+            status = "reached_since" if reached_since else ("reached_end" if posts_has_more != 1 else "hit_max_posts")
+            utils.logger.info(f"[DouYinClient.get_all_user_aweme_posts] BENCHMARK sec_user_id:{sec_user_id} total={len(result)} status={status}")
         return result
 
